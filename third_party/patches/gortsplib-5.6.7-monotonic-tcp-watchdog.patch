index 0000000000000000000000000000000000000000..96463f05b3d7f2a2d448407d5553f3f5fad45e09
--- /dev/null
+++ b/client_tcp_watchdog_clock_test.go
@@ -0,0 +1,86 @@
+package gortsplib
+
+import (
+	"bufio"
+	"errors"
+	"io"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/bluenviron/gortsplib/v5/pkg/base"
+	"github.com/bluenviron/gortsplib/v5/pkg/conn"
+)
+
+// Exercise the actual packet-reader store, without sockets or a modified
+// watchdog. This file also compiles against the unmodified upstream module.
+func k5TCPWatchdogInbound(t *testing.T, c *Client) {
+	t.Helper()
+	c.chResponse = make(chan *base.Response, 1)
+	c.conn = conn.NewConn(bufio.NewReader(strings.NewReader(
+		"RTSP/1.0 200 OK\r\nCSeq: 1\r\n\r\n")), io.Discard)
+	r := clientReader{c: c, terminate: make(chan struct{})}
+	if err := r.runInner(); !errors.Is(err, io.EOF) {
+		t.Fatalf("packet reader must retain EOF behavior: %v", err)
+	}
+	select {
+	case response := <-c.chResponse:
+		if response.StatusCode != base.StatusOK {
+			t.Fatal("the inbound response was not dispatched")
+		}
+	default:
+		t.Fatal("the inbound response was not dispatched")
+	}
+}
+
+func k5TCPWatchdogClockFixture(t *testing.T, wall *time.Time, timeout time.Duration) *Client {
+	t.Helper()
+	c := &Client{
+		Scheme: "rtsp", Host: "127.0.0.1:8554", ReadTimeout: timeout,
+		timeNow: func() time.Time { return *wall },
+	}
+	if err := c.Start(); err != nil {
+		t.Fatal(err)
+	}
+	// Start initializes the real default clock. Its idle actor is then stopped
+	// before this synchronous reader/watchdog test changes the injected UTC.
+	c.Close()
+	k5TCPWatchdogInbound(t, c)
+	return c
+}
+
+func TestClientTCPWatchdogWallClockForward(t *testing.T) {
+	wall := time.Date(2026, time.November, 22, 0, 0, 0, 0, time.UTC)
+	c := k5TCPWatchdogClockFixture(t, &wall, 30*time.Second)
+	if c.isInTCPTimeout() {
+		t.Fatal("a newly received packet is not idle")
+	}
+	wall = wall.Add(48 * time.Hour)
+	if c.isInTCPTimeout() {
+		t.Fatal("a UTC forward step expired a freshly received TCP packet")
+	}
+	if !c.timeNow().Equal(wall) {
+		t.Fatal("the actual UTC clock must remain available to protocol timestamps")
+	}
+}
+
+func TestClientTCPWatchdogWallClockBackward(t *testing.T) {
+	wall := time.Date(2026, time.November, 22, 0, 0, 0, 0, time.UTC)
+	c := k5TCPWatchdogClockFixture(t, &wall, time.Second)
+	wall = wall.Add(-48 * time.Hour)
+	deadline := time.Now().Add(3 * time.Second)
+	for !c.isInTCPTimeout() && time.Now().Before(deadline) {
+		time.Sleep(10 * time.Millisecond)
+	}
+	if !c.isInTCPTimeout() {
+		t.Fatal("a UTC backward step prevented the configured genuine-idle timeout")
+	}
+	// Another actual response refreshes liveness without correcting UTC.
+	k5TCPWatchdogInbound(t, c)
+	if c.isInTCPTimeout() {
+		t.Fatal("a newly received packet did not refresh liveness")
+	}
+	if !c.timeNow().Equal(wall) {
+		t.Fatal("the actual UTC clock was changed")
+	}
+}
diff --git a/client_tcp_watchdog_elapsed_test.go b/client_tcp_watchdog_elapsed_test.go
