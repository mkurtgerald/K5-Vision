index 0000000000000000000000000000000000000000..39e337d9ba7d8ba264db3be6cc9874e2d1e5a709
--- /dev/null
+++ b/client_tcp_watchdog_elapsed_test.go
@@ -0,0 +1,76 @@
+package gortsplib
+
+import (
+	"bufio"
+	"errors"
+	"io"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/bluenviron/gortsplib/v5/pkg/conn"
+)
+
+func TestClientTCPWatchdogElapsedDeadline(t *testing.T) {
+	for _, offset := range []time.Duration{-48 * time.Hour, 0, 48 * time.Hour} {
+		t.Run(offset.String(), func(t *testing.T) {
+			elapsed := time.Duration(0)
+			wall := time.Date(2026, time.November, 22, 0, 0, 0, 0, time.UTC).Add(offset)
+			c := &Client{
+				ReadTimeout:   time.Second,
+				timeNow:       func() time.Time { return wall },
+				timeMonotonic: func() time.Duration { return elapsed },
+			}
+			k5TCPWatchdogInbound(t, c)
+			if c.tcpLastInboundTime.Load() != 0 || c.isInTCPTimeout() {
+				t.Fatal("zero elapsed time is a valid fresh packet timestamp")
+			}
+			elapsed = time.Second - time.Nanosecond
+			if c.isInTCPTimeout() {
+				t.Fatal("the configured read timeout was shortened")
+			}
+			elapsed = time.Second
+			if !c.isInTCPTimeout() {
+				t.Fatal("the configured read timeout was extended")
+			}
+			k5TCPWatchdogInbound(t, c)
+			if c.isInTCPTimeout() {
+				t.Fatal("another inbound packet must refresh liveness")
+			}
+			// A concurrent packet can be newer than a checker's sampled clock.
+			c.tcpLastInboundTime.Store(int64(elapsed + time.Nanosecond))
+			if c.isInTCPTimeout() {
+				t.Fatal("a raced newer packet must not appear idle")
+			}
+		})
+	}
+}
+
+func TestClientTCPWatchdogEOFDoesNotRefresh(t *testing.T) {
+	elapsed := time.Duration(0)
+	c := &Client{ReadTimeout: time.Second, timeMonotonic: func() time.Duration { return elapsed }}
+	k5TCPWatchdogInbound(t, c)
+	elapsed = 2 * time.Second
+	c.conn = conn.NewConn(bufio.NewReader(strings.NewReader("")), io.Discard)
+	r := clientReader{c: c, terminate: make(chan struct{})}
+	if err := r.runInner(); !errors.Is(err, io.EOF) {
+		t.Fatalf("socket EOF handling changed: %v", err)
+	}
+	if !c.isInTCPTimeout() {
+		t.Fatal("an EOF refreshed liveness instead of retaining the idle timeout")
+	}
+}
+
+func TestClientTCPWatchdogConcurrentRefresh(t *testing.T) {
+	c := &Client{ReadTimeout: time.Second}
+	c.tcpLastInboundTime.Store(0)
+	c.timeMonotonic = func() time.Duration {
+		// Model a checker yielding during its clock sample while the packet
+		// reader records fresh traffic. The atomic load must follow the clock.
+		c.tcpLastInboundTime.Store(int64(5 * time.Second))
+		return 5 * time.Second
+	}
+	if c.isInTCPTimeout() {
+		t.Fatal("a concurrent inbound refresh was ignored by the timeout checker")
+	}
+}
